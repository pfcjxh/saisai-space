# ============================================================================
# 赛赛 · 双人空间 —— 环境变量模板
#
# 用法：cp .env.example .env 后填入真实值。.env 已被 .gitignore 排除，切勿提交。
# 本文件**不得**写入任何真实凭据（历史版本曾提交过真实 URL 与密钥，已整改）。
# ============================================================================

# Supabase 项目配置（Dashboard -> Project Settings -> API）
# 形如 https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# anon / publishable key：可公开，但仍建议按环境区分
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# 仅本机脚本使用（scripts/*.mjs、tests/*.mjs）——绝不进入前端包
# ---------------------------------------------------------------------------

# service_role / secret key：可绕过全部 RLS，仅用于本地联调脚本
# Dashboard -> Project Settings -> API -> service_role
SUPABASE_SECRET_KEY=your-service-role-key

# Supabase 管理 API 访问令牌（scripts/verify-push-chain.mjs 查 pg_net 响应与 cron 任务）
# Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=your-management-api-token

# ---------------------------------------------------------------------------
# Web Push（可选）
# ---------------------------------------------------------------------------

# VAPID 公钥：npx web-push generate-vapid-keys --json
# 未配置时前端自动进入 Mock 模式（不发起真实订阅）
VITE_VAPID_PUBLIC_KEY=

# VAPID 私钥与主题：仅配置到 Edge Function Secrets，不要写入本文件
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com

# 推送调度共享密钥：**不要在此填写**。
# 由迁移 20260916000500 在 Supabase Vault 中自动生成，迁移 20260916000900 负责轮换。
# 取回明文：SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name = 'push_webhook_secret';
# 同步到函数：supabase secrets set PUSH_WEBHOOK_SECRET="<上一步取回的值>"

# ---------------------------------------------------------------------------
# 部署（可选，Cloudflare Pages）
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
