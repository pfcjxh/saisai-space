<script setup lang="ts">
import { computed } from 'vue';
import { Heart, Palette, Settings } from '@lucide/vue';
import type { Mood } from '@/types/database';

/**
 * Tier 1 — 参考设计问候头部：
 * 大号时段问候 + 右侧相恋天数；日期 · 伴侣指示；情话行；双方真实头像。
 * 点击自己的头像唤起心情打卡抽屉。
 */
const props = defineProps<{
  /** 用户时区下的当前小时 0-23 */
  hour: number;
  /** 「9月16日 周三」 */
  dateLabel: string;
  /** 伴侣指示：她 / 他 */
  partnerLabel: string;
  loveNote: string;
  /** 在一起第 N 天（已含首日） */
  daysTogether: number;
  myMood: Mood | null;
  partnerMood: Mood | null;
  /** 我的头像 URL（profiles.avatar_url 或本地默认图） */
  myAvatarUrl: string;
  partnerAvatarUrl: string;
  partnerNickname: string;
}>();

const emit = defineEmits<{ openMoodPicker: []; openSettings: []; openTheme: [] }>();

const MOOD_LABELS: Record<Mood, string> = {
  calm: '平静',
  happy: '开心',
  tired: '疲惫',
  caring: '关怀',
  sleepy: '困倦',
};

const greeting = computed(() => {
  const h = props.hour;
  if (h >= 23 || h < 5) return '夜已深';
  if (h < 8) return '清晨好';
  if (h < 12) return '早上好';
  if (h < 18) return '下午好';
  return '晚上好';
});

function moodLabel(mood: Mood | null): string {
  return mood ? MOOD_LABELS[mood] : '未打卡';
}
</script>

<template>
  <header class="flex flex-col gap-3">
    <div class="flex items-start justify-between">
      <h1 class="text-[28px] leading-tight font-bold">{{ greeting }}</h1>
      <div class="flex items-start gap-3">
        <div class="mt-0.5 shrink-0 text-right">
          <p class="text-xl leading-none font-semibold text-amber-warm tabular-nums">
            {{ daysTogether }}<span class="ml-0.5 text-xs font-normal">天</span>
          </p>
          <p class="mt-1 text-[10px] text-fg-soft">在一起</p>
        </div>
        <button
          type="button"
          class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-card text-fg-soft transition-transform duration-200 ease-out-quart active:scale-90"
          aria-label="外观主题"
          @click="emit('openTheme')"
        >
          <Palette :size="16" :stroke-width="1.8" />
        </button>
        <button
          type="button"
          class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-card text-fg-soft transition-transform duration-200 ease-out-quart active:scale-90"
          aria-label="消息提醒设置"
          @click="emit('openSettings')"
        >
          <Settings :size="16" :stroke-width="1.8" />
        </button>
      </div>
    </div>

    <p class="text-sm text-fg-soft tabular-nums">{{ dateLabel }} · {{ partnerLabel }}</p>
    <p class="text-[15px] text-fg-soft">{{ loveNote }}</p>

    <div class="mt-1 flex items-center gap-4">
      <button
        type="button"
        class="flex flex-col items-center gap-1 transition-transform duration-200 ease-out-quart active:scale-95"
        aria-label="打卡此刻心情"
        @click="emit('openMoodPicker')"
      >
        <img
          :src="myAvatarUrl"
          alt="我"
          class="size-10 rounded-full bg-white object-cover ring-1 ring-separator"
        />
        <span class="text-[10px] text-fg-soft">我 · {{ moodLabel(myMood) }}</span>
      </button>

      <Heart :size="12" class="shrink-0 text-amber-warm" fill="currentColor" aria-hidden="true" />

      <div class="flex flex-col items-center gap-1">
        <img
          :src="partnerAvatarUrl"
          :alt="partnerNickname"
          class="size-10 rounded-full bg-white object-cover ring-1 ring-separator"
        />
        <span class="text-[10px] text-fg-soft">
          {{ partnerNickname }} · {{ moodLabel(partnerMood) }}
        </span>
      </div>
    </div>
  </header>
</template>

